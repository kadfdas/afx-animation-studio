{
  "name": "afx-animation-studio",
  "version": "1.1.1",
  "description": "AFX 动画工坊 — 前端动画编辑器（Electron 桌面版）",
  "main": "main.js",
  "author": {
    "name": "AFX",
    "email": "kadfdas@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:all": "electron-builder -wml"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.afx.animationstudio",
    "productName": "AFX动画工坊",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AFX动画工坊"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video-graphics-app",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "AFX Animation Studio ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  }
}
